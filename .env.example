# Copy this file to .env and adjust values as needed.
# Never commit the real .env file or hard-code secrets in the Android app.

# Model identifier on the Hugging Face hub.
# "facebook/nllb-200-distilled-600M" is lighter; "facebook/nllb-200-3.3B" is more accurate.
NLLB_MODEL=facebook/nllb-200-distilled-600M

# Use CPU ("cpu") or GPU ("cuda") for model inference.
DEVICE=cpu

# Maximum number of tokens the model will generate per request.
MAX_SOURCE_LENGTH=512
MAX_TARGET_LENGTH=512

# Optional: allow CORS only from a known origin. Use a comma-separated list.
# Leave blank to allow the Android app to connect from any origin during development.
ALLOWED_ORIGINS=

# Host/port the API listens on.
HOST=0.0.0.0
PORT=8000
